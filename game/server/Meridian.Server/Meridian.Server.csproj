  </PropertyGroup>

  <ItemGroup>
    <!-- Weltdaten neben die ausführbare Datei kopieren -->
    <None Include="..\data\**\*.json" LinkBase="data" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

</Project>
